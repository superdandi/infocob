# Google Gemini API Key para el chat IA
# 1. Ir a https://aistudio.google.com/apikey
# 2. Crear API key (gratis, sin tarjeta)
# 3. Restringir por HTTP referrer: superdandi.github.io/*
# 4. Copiar el key aquí (sin comillas):
NEXT_PUBLIC_GEMINI_API_KEY=

# Groq API Key (fallback cuando Gemini está rate-limited)
# 1. Ir a https://console.groq.com/keys
# 2. Crear API key (gratis, requiere registrarse)
# 3. Restringir por HTTP referrer: superdandi.github.io/*
# 4. Copiar el key aquí (sin comillas):
NEXT_PUBLIC_GROQ_API_KEY=

# OpenRouter API Key (tercer fallback)
# 1. Ir a https://openrouter.ai/keys
# 2. Crear cuenta y API key (gratis, sin tarjeta)
# 3. Copiar el key aquí (sin comillas):
NEXT_PUBLIC_OPENROUTER_API_KEY=

# Web3Forms Access Key (formulario de contacto → email)
# 1. Ir a https://web3forms.com/ → Create your Form
# 2. Verificar email → obtener Access Key
# 3. Copiar el key aquí (sin comillas):
NEXT_PUBLIC_WEB3FORMS_KEY=

# Google Analytics 4 Measurement ID (tracking)
# 1. Ir a https://analytics.google.com/
# 2. Crear propiedad GA4 → obtener ID tipo G-XXXXXXXXXX
# 3. Copiar el ID aquí (sin comillas, opcional — si se omite no se carga):
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity Project ID (sesiones grabadas y heatmaps)
# 1. Ir a https://clarity.microsoft.com/
# 2. Crear proyecto con URL base del sitio
# 3. Copiar el ID del proyecto aquí (opcional — si se omite no se carga):
NEXT_PUBLIC_CLARITY_ID=
